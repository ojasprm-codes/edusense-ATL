# Optional overrides. Copy values into the systemd service environment or a
# root/owner-readable environment file; do not commit the populated file.
EDUSENSE_TIMEZONE=Asia/Kolkata
EDUSENSE_SERIAL_PORT=/dev/ttyACM0
EDUSENSE_BAUD_RATE=9600
EDUSENSE_HOST=127.0.0.1
EDUSENSE_PORT=5000
EDUSENSE_DB=/var/lib/edusense/edusense.db
EDUSENSE_CLOUD_URL=https://your-worker.workers.dev
EDUSENSE_DEVICE_CREDENTIALS=/var/lib/edusense/device.json
EDUSENSE_PROVISION_STATE=/var/lib/edusense/provisioning.json

# Optional report wording provider. Leave unset for deterministic local reports.
EDUSENSE_AI_PROVIDER=
GEMINI_API_KEY=
OPENAI_API_KEY=
